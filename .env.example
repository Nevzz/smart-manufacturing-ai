# PostgreSQL (optional -- the app falls back to CSV files if unavailable)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_manufacturing
DB_USER=postgres
DB_PASSWORD=your_password

# LLM for the maintenance assistant (module 4)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Alternative provider
# LLM_PROVIDER=google
# GOOGLE_API_KEY=...
